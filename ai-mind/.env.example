# Copy this file to .env and set values for local development.
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free
AI_MAX_TOKENS=800
# Automatically extract durable memories and refresh context in the background.
AI_AUTO_MEMORY=true
AI_MEMORY_MIN_CONFIDENCE=0.88
AI_MEMORY_MIN_IMPORTANCE=0.70
AI_SUMMARY_EVERY_MESSAGES=8
# Remember provider rate limits across restarts for this many minutes.
AI_QUOTA_COOLDOWN_MINUTES=15
# Optional order for summaries, retrieval, and other background requests.
# Providers omitted here retain their normal order after these entries.
AI_BACKGROUND_PROVIDER_ORDER=